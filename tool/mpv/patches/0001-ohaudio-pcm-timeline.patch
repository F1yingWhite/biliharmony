diff --git a/audio/out/pcm_timeline.c b/audio/out/pcm_timeline.c
new file mode 100644
--- /dev/null
+++ b/audio/out/pcm_timeline.c
@@ -0,0 +1,157 @@
+// Use each aframe's effective rate before it becomes bare PCM. A later speed
+// command cannot change the PTS or sample duration of PCM already queued.
+#include "pcm_timeline.h"
+#include <stddef.h>
+
+static double abs_double(double v) { return v < 0 ? -v : v; }
+static bool valid_pts(double v)
+{
+    return v != MP_PCM_TIMELINE_NOPTS && v > -1e20 && v < 1e20;
+}
+
+bool mp_pcm_timestamp_from_monotonic(int64_t hardware_ns, int64_t monotonic_ns,
+                                     int64_t mp_before_ns, int64_t mp_after_ns,
+                                     int64_t *timestamp_ns)
+{
+    *timestamp_ns = 0;
+    if (hardware_ns <= 0 || monotonic_ns <= 0 || hardware_ns > monotonic_ns ||
+        mp_before_ns <= 0 || mp_after_ns < mp_before_ns)
+        return false;
+    int64_t age = monotonic_ns - hardware_ns;
+    if (age >= INT64_C(2000000000))
+        return false;
+    int64_t midpoint = mp_before_ns + (mp_after_ns - mp_before_ns) / 2;
+    int64_t timestamp = midpoint - age;
+    if (timestamp <= 0)
+        return false;
+    *timestamp_ns = timestamp;
+    return true;
+}
+
+void mp_pcm_timeline_reset(struct mp_pcm_timeline *t)
+{
+    t->count = t->rate = 0;
+    t->sent = t->callback_first = t->clock_sample = t->clock_ns = t->pause_ns = 0;
+    t->clock_valid = t->paused = t->disabled = false;
+}
+
+static double sample_at(const struct mp_pcm_timeline *t, int64_t now_ns)
+{
+    if (t->paused) now_ns = t->pause_ns;
+    return t->clock_sample + (double)(now_ns - t->clock_ns) * t->rate / 1e9;
+}
+
+void mp_pcm_timeline_begin(struct mp_pcm_timeline *t, int rate, int samples,
+                           int64_t output_end_ns, int64_t now_ns)
+{
+    if (t->disabled || rate <= 0 || samples < 0 || output_end_ns <= 0) return;
+    if (t->rate != rate) mp_pcm_timeline_reset(t);
+    t->rate = rate;
+    t->callback_first = t->sent;
+    t->sent += samples; // Includes silence: the hardware consumes those samples.
+    t->clock_sample = t->sent;
+    t->clock_ns = output_end_ns;
+    t->clock_valid = true;
+    // Keep the preceding segment through a silent gap, so the media clock
+    // stops at its last valid sample rather than advancing through silence.
+    double played = sample_at(t, now_ns);
+    int remove = 0;
+    while (remove + 1 < t->count && t->segments[remove + 1].first <= played)
+        remove++;
+    for (int n = remove; n < t->count; n++) t->segments[n - remove] = t->segments[n];
+    t->count -= remove;
+}
+
+void mp_pcm_timeline_add(struct mp_pcm_timeline *t, int offset, int samples,
+                         double pts, double effective_rate)
+{
+    if (!t->clock_valid || samples <= 0 || offset < 0 ||
+        t->callback_first + offset + samples > t->sent)
+        return;
+    bool valid = valid_pts(pts) && effective_rate > 0 && effective_rate < 1e20;
+    struct mp_pcm_segment next = {
+        .first = t->callback_first + offset,
+        .last = t->callback_first + offset + samples,
+        .pts = valid ? pts : MP_PCM_TIMELINE_NOPTS,
+        .end_pts = valid ? pts + samples / effective_rate : MP_PCM_TIMELINE_NOPTS,
+    };
+    if (valid && t->count) {
+        struct mp_pcm_segment *last = &t->segments[t->count - 1];
+        double a = (last->end_pts - last->pts) / (last->last - last->first);
+        double b = 1.0 / effective_rate;
+        if (valid_pts(last->pts) && last->last == next.first &&
+            abs_double(last->end_pts - next.pts) < 1e-9 &&
+            abs_double(a - b) < 1e-12) {
+            last->last = next.last;
+            last->end_pts = next.end_pts;
+            return;
+        }
+    }
+    // Never overwrite a segment which has not reached the speakers. In an
+    // exceptional overflow, disable the mapping and use the legacy fallback.
+    if (t->count == MP_PCM_TIMELINE_CAPACITY) {
+        t->count = 0;
+        t->clock_valid = false;
+        t->disabled = true;
+        return;
+    }
+    t->segments[t->count++] = next;
+}
+
+void mp_pcm_timeline_pause(struct mp_pcm_timeline *t, bool paused, int64_t now_ns)
+{
+    if (paused == t->paused) return;
+    if (paused) t->pause_ns = now_ns;
+    else if (t->clock_valid) t->clock_ns += now_ns - t->pause_ns;
+    t->paused = paused;
+}
+
+bool mp_pcm_timeline_pts(const struct mp_pcm_timeline *t, int64_t now_ns, double *pts)
+{
+    *pts = MP_PCM_TIMELINE_NOPTS;
+    if (!t->clock_valid || !t->count) return false;
+    double played = sample_at(t, now_ns);
+    double value = t->segments[0].pts;
+    for (int n = 0; n < t->count; n++) {
+        const struct mp_pcm_segment *s = &t->segments[n];
+        if (played < s->first) {
+            if (!valid_pts(value)) return false;
+            *pts = value;
+            return true;
+        }
+        if (played < s->last) {
+            if (!valid_pts(s->pts)) return false;
+            *pts = s->pts + (played - s->first) * (s->end_pts - s->pts) / (s->last - s->first);
+            return true;
+        }
+        value = s->end_pts;
+    }
+    if (!valid_pts(value)) return false;
+    *pts = value;
+    return true;
+}
+
+bool mp_pcm_timeline_deadline(const struct mp_pcm_timeline *t, double pts,
+                              int64_t now_ns, double *seconds)
+{
+    if (!t->clock_valid || !t->count || !valid_pts(pts)) return false;
+    const struct mp_pcm_segment *s = NULL;
+    for (int n = 0; n < t->count; n++) {
+        const struct mp_pcm_segment *candidate = &t->segments[n];
+        if (valid_pts(candidate->pts) && pts >= candidate->pts && pts <= candidate->end_pts) {
+            s = candidate;
+            break;
+        }
+    }
+    if (!s && pts < t->segments[0].pts) s = &t->segments[0];
+    if (!s && pts > t->segments[t->count - 1].end_pts) s = &t->segments[t->count - 1];
+    if (!s || !valid_pts(s->pts)) return false;
+    double duration = s->end_pts - s->pts;
+    if (!(duration > 0)) return false;
+    double sample = s->first + (pts - s->pts) * (s->last - s->first) / duration;
+    // Extrapolate only with the adjoining PCM segment's actual rate; never
+    // use the latest requested speed to reinterpret the queue.
+    if (t->paused) now_ns = t->pause_ns;
+    *seconds = (sample - t->clock_sample) / t->rate + (t->clock_ns - now_ns) / 1e9;
+    return true;
+}
diff --git a/audio/out/pcm_timeline.h b/audio/out/pcm_timeline.h
new file mode 100644
--- /dev/null
+++ b/audio/out/pcm_timeline.h
@@ -0,0 +1,38 @@
+// PCM sample-clock to media-PTS mapping. Does not change or own audio data.
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+#define MP_PCM_TIMELINE_CAPACITY 512
+// Same value as MP_NOPTS_VALUE in common/common.h. Keep this module usable
+// without mpv/FFmpeg headers for freestanding clock tests.
+#define MP_PCM_TIMELINE_NOPTS (-0x1p+63)
+
+struct mp_pcm_segment {
+    int64_t first, last;
+    double pts, end_pts;
+};
+
+struct mp_pcm_timeline {
+    struct mp_pcm_segment segments[MP_PCM_TIMELINE_CAPACITY];
+    int count, rate;
+    int64_t sent, callback_first, clock_sample, clock_ns, pause_ns;
+    bool clock_valid, paused, disabled;
+};
+
+// Bridge OHAudio's absolute CLOCK_MONOTONIC timestamp to mpv's relative clock.
+// The mpv clock may use CLOCK_MONOTONIC_RAW, so its raw-time offset is not enough.
+bool mp_pcm_timestamp_from_monotonic(int64_t hardware_ns, int64_t monotonic_ns,
+                                     int64_t mp_before_ns, int64_t mp_after_ns,
+                                     int64_t *timestamp_ns);
+
+void mp_pcm_timeline_reset(struct mp_pcm_timeline *t);
+void mp_pcm_timeline_begin(struct mp_pcm_timeline *t, int rate, int samples,
+                           int64_t output_end_ns, int64_t now_ns);
+void mp_pcm_timeline_add(struct mp_pcm_timeline *t, int offset, int samples,
+                         double pts, double effective_rate);
+void mp_pcm_timeline_pause(struct mp_pcm_timeline *t, bool paused, int64_t now_ns);
+bool mp_pcm_timeline_pts(const struct mp_pcm_timeline *t, int64_t now_ns,
+                         double *pts);
+bool mp_pcm_timeline_deadline(const struct mp_pcm_timeline *t, double pts,
+                              int64_t now_ns, double *seconds);
