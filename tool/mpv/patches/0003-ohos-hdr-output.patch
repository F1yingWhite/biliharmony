+        : (struct mpegl_cb){.auto_r=8, .auto_g=8, .auto_b=8, .auto_a=8};
+    if (!mpegl_create_context_cb(ctx, p->egl_display, cb,
+                                &p->egl_context, &p->egl_config)) {
+        HDR_DIAG(ctx, "createContext request10=%{public}d failed", ten_bit);
+        return false;
+    }
+    int visual = 0;
