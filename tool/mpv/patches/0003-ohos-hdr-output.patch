+        !eglGetConfigAttrib(p->egl_display, p->egl_config, EGL_GREEN_SIZE, &p->g) ||
+        !eglGetConfigAttrib(p->egl_display, p->egl_config, EGL_BLUE_SIZE, &p->b) ||
+        !eglGetConfigAttrib(p->egl_display, p->egl_config, EGL_ALPHA_SIZE, &p->a) ||
+        !eglGetConfigAttrib(p->egl_display, p->egl_config, EGL_NATIVE_VISUAL_ID, &visual))
+        return false;
+    int bits = ten_bit ? 10 : 8;
+    int alpha = ten_bit ? 2 : 8;
+    int format = ten_bit ? NATIVEBUFFER_PIXEL_FMT_RGBA_1010102
+                         : NATIVEBUFFER_PIXEL_FMT_RGBA_8888;
+    HDR_DIAG(ctx, "eglConfig request10=%{public}d r=%{public}d g=%{public}d b=%{public}d a=%{public}d visual=%{public}d",
+             ten_bit, p->r, p->g, p->b, p->a, visual);
+    if (p->r != bits || p->g != bits || p->b != bits || p->a != alpha || visual != format)
+        return false;
+    OHNativeWindow *window = vo_ohos_native_window(ctx->vo);
+    if (OH_NativeWindow_NativeWindowHandleOpt(window, SET_FORMAT, visual) ||
